# Cloudflare Pages response headers (ignored by GitHub Pages).
# Framework content-hashes everything under these paths, so they can be cached forever;
# HTML pages keep the host's default short cache so monthly updates appear promptly.
/_npm/*
  Cache-Control: public, max-age=31536000, immutable
/_observablehq/*
  Cache-Control: public, max-age=31536000, immutable
/_import/*
  Cache-Control: public, max-age=31536000, immutable
/_file/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
